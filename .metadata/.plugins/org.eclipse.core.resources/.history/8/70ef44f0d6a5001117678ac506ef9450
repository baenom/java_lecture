package grammar;

import java.util.Scanner;

public class While01 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner in = new Scanner(System.in);
		int sum = 0;
		while(true) {
			System.out.print("숫자를 입력하세요:");
			int n = in.nextInt();
			
			if(n == 0) {
				break;
			}
			sum += n;
		}
	}

}
