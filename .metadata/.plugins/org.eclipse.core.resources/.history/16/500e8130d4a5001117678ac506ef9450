package grammar;

import java.util.Scanner;

public class Coin {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner in = new Scanner(System.in);
		
		System.out.print("금액 :");
		int c = in.nextInt();
		
		System.out.print("동전의 수 >");
		System.out.print(c / 500);
		System.out.print((c % 500) / 100);
	}

}
